# ─────────────────────────────────────────────────────────────────────────────
# ChantierLink — variables d'environnement
# Copiez ce fichier en `.env`. Les valeurs par défaut permettent de tout essayer
# en local SANS aucune clé API (tous les services externes sont simulés).
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'application (utilisée dans les liens envoyés par e-mail / WhatsApp)
APP_URL=http://localhost:3000

# Secret de l'application (≥ 32 caractères) : signature des URL de fichiers, etc.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-in-production-please-use-48-random-bytes

# Base PostgreSQL. Port 5433 : Postgres local (pnpm db:local) ou docker-compose.dev.yml.
DATABASE_URL=postgresql://chantierlink:chantierlink@localhost:5433/chantierlink

# Niveau de logs pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Pages /dev/* (simulateurs WhatsApp, e-mail entrant, boîte mail de dev).
# Toujours actives hors production ; mettre `true` pour les forcer (démo), `false` en vraie production.
ENABLE_DEV_TOOLS=false

# ── Stockage des fichiers ────────────────────────────────────────────────────
# local : disque (dossier STORAGE_LOCAL_DIR) — aucun service requis
# s3    : MinIO / S3 compatible (hébergement UE recommandé)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=chantierlink
S3_ACCESS_KEY_ID=chantierlink
S3_SECRET_ACCESS_KEY=chantierlink-secret
S3_FORCE_PATH_STYLE=true
# Taille maximale d'un fichier envoyé (Mo)
MAX_UPLOAD_MB=25

# ── E-mail sortant ───────────────────────────────────────────────────────────
# dev     : e-mails enregistrés en base et visibles sur /dev/mails (aucun serveur requis)
# console : e-mails affichés dans les logs
# smtp    : vrai serveur SMTP (Mailpit en local : SMTP_HOST=localhost, SMTP_PORT=1025)
MAIL_DRIVER=dev
MAIL_FROM="ChantierLink <no-reply@chantierlink.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── E-mail entrant (classement automatique des papiers) ──────────────────────
# Adresse de dépôt par organisation : docs-<slug>@INBOUND_MAIL_DOMAIN
INBOUND_MAIL_DOMAIN=docs.chantierlink.local
# Secret attendu dans l'en-tête X-Inbound-Secret du webhook /api/webhooks/inbound-mail
INBOUND_MAIL_SECRET=dev-inbound-secret

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# mock : simulateur local (/dev/whatsapp) · meta : WhatsApp Business Cloud API
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Numéro affiché aux utilisateurs (format international)
WHATSAPP_BUSINESS_NUMBER=+33600000000

# ── Transcription des vocaux ─────────────────────────────────────────────────
# mock : texte fictif · whisper : API compatible Whisper (OpenAI ou whisper.cpp server)
TRANSCRIPTION_PROVIDER=mock
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ── IA (résumés, classement) ─────────────────────────────────────────────────
# mock : réponses déterministes · anthropic : API Claude
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Seuil de confiance au-delà duquel un élément est classé automatiquement (0 à 1)
AUTO_CLASSIFY_THRESHOLD=0.75

# ── OCR ──────────────────────────────────────────────────────────────────────
# mock : texte fictif · tesseract : tesseract.js (langue fra)
OCR_PROVIDER=mock

# ── Abonnement ───────────────────────────────────────────────────────────────
# false : pas de limites ni de page de paiement
BILLING_ENABLED=false
# mock : faux paiement · stripe : Stripe Checkout
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_PRO=

# ── Notifications push web (optionnel) ──────────────────────────────────────
# Générer : pnpm vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@chantierlink.local
