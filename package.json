{
  "name": "chantierlink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "dev:local": "concurrently -k -n db,app -c blue,green \"pnpm db:local\" \"pnpm setup --no-seed && concurrently -k -n next,worker -c green,magenta \\\"pnpm dev\\\" \\\"pnpm worker\\\"\"",
    "worker": "tsx src/worker/index.ts",
    "dev:all": "concurrently -k -n next,worker -c green,magenta \"pnpm dev\" \"pnpm worker\"",
    "vapid": "tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1174.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "file-type": "^22.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.77.0",
    "mailparser": "^3.15.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.1",
    "papaparse": "^5.7.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.2.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "embedded-postgres": "18.7.0-beta.19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
