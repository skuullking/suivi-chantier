// ChantierLink — data model.
// Every business table carries `organizationId` (strict multi-tenancy, enforced server-side in services).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  OWNER
  OFFICE
  WORKER
}

enum Trade {
  CARPENTER
  JOINER
  POOL
  RENOVATION
  LANDSCAPER
  OTHER
}

enum Plan {
  SOLO
  TEAM
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ClientType {
  INDIVIDUAL
  PROFESSIONAL
}

enum SiteStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum StepStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Slot {
  FULL_DAY
  MORNING
  AFTERNOON
}

enum TaskStatus {
  TODO
  DONE
}

enum MediaKind {
  PHOTO
  VOICE
  VIDEO
}

enum MediaSource {
  APP
  WHATSAPP
  EMAIL
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum InboxKind {
  MEDIA
  MESSAGE
  DOCUMENT
}

enum InboxStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum DocumentType {
  QUOTE
  INVOICE
  PURCHASE_ORDER
  EXPENSE
  CONTRACT
  PLAN
  OTHER
}

enum DocumentSource {
  UPLOAD
  EMAIL
  WHATSAPP
  GENERATED
}

enum SummaryStatus {
  DRAFT
  APPROVED
  SENT
}

enum NoteKind {
  NOTE
  PROBLEM
  VOICE
}

enum MessageChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ───────────────────────────── Tenancy & auth ─────────────────────────────

model Organization {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  trade              Trade              @default(OTHER)
  logoKey            String?
  timezone           String             @default("Europe/Paris")
  phone              String?
  email              String?
  address            String?
  plan               Plan               @default(TEAM)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  siteCounter        Int                @default(0)

  // Settings
  photosAutoApprove       Boolean @default(false)
  officeCanValidatePhotos Boolean @default(true)
  summaryAutoSend         Boolean @default(false)
  summaryHour             Int     @default(18)
  reminderHour            Int     @default(19)
  retentionDocumentsYears Int     @default(10)
  retentionMediaYears     Int     @default(10)
  retentionPurgeEnabled   Boolean @default(false)
  onboardingDismissed     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  sessions         Session[]
  clients          Client[]
  sites            Site[]
  stepTemplates    StepTemplate[]
  siteSteps        SiteStep[]
  assignments      Assignment[]
  tasks            Task[]
  media            Media[]
  inboxItems       InboxItem[]
  documents        Document[]
  dailySummaries   DailySummary[]
  portalLinks      ClientPortalLink[]
  whatsappContacts WhatsAppContact[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  subscription     Subscription?
  notes            Note[]
  siteEvents       SiteEvent[]
  messageLogs      MessageLog[]
  siteMembers      SiteMember[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationInvitedBy")
  assignments         Assignment[]
  tasks               Task[]               @relation("TaskAssignee")
  mediaAuthored       Media[]              @relation("MediaAuthor")
  notifications       Notification[]
  whatsappContacts    WhatsAppContact[]
  pushSubscriptions   PushSubscription[]
  notes               Note[]
  documentsUploaded   Document[]
  siteMemberships     SiteMember[]
}

model Session {
  /// SHA-256 of the session token stored in the cookie.
  id             String       @id
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  ip             String?
  userAgent      String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  name           String?
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Clients & sites ─────────────────────────────

model Client {
  id                    String                   @id @default(cuid())
  organizationId        String
  type                  ClientType               @default(INDIVIDUAL)
  name                  String
  companyName           String?
  emails                String[]
  phones                String[]
  addresses             String[]
  notes                 String?
  tags                  String[]
  consentCommunications Boolean                  @default(false)
  archivedAt            DateTime?
  anonymizedAt          DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  /// Maintained by a database trigger (full-text search).
  searchVector          Unsupported("tsvector")?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites            Site[]
  documents        Document[]
  whatsappContacts WhatsAppContact[]
  inboxProposals   InboxItem[]       @relation("InboxProposedClient")

  @@index([organizationId])
  @@index([organizationId, archivedAt])
  @@index([searchVector], type: Gin)
}

model Site {
  id             String                   @id @default(cuid())
  organizationId String
  clientId       String
  /// Short human code, unique per organization (e.g. "DUP-3"), usable in WhatsApp messages.
  code           String
  title          String
  address        String
  postalCode     String?
  city           String?
  latitude       Float?
  longitude      Float?
  status         SiteStatus               @default(DRAFT)
  plannedStart   DateTime?                @db.Date
  plannedEnd     DateTime?                @db.Date
  actualStart    DateTime?                @db.Date
  actualEnd      DateTime?                @db.Date
  description    String?
  /// Instructions for workers (consignes).
  instructions   String?
  /// Weighted progress in percent (0-100), recomputed on every step change.
  progress       Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  searchVector   Unsupported("tsvector")?

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  steps          SiteStep[]
  assignments    Assignment[]
  tasks          Task[]
  media          Media[]
  documents      Document[]
  dailySummaries DailySummary[]
  portalLinks    ClientPortalLink[]
  notes          Note[]
  events         SiteEvent[]
  inboxProposals InboxItem[]        @relation("InboxProposedSite")
  members        SiteMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([plannedStart])
  @@index([searchVector], type: Gin)
}

/// Team of a site: users allowed to see it (workers only see sites they are members of).
model SiteMember {
  id             String       @id @default(cuid())
  organizationId String
  siteId         String
  userId         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([userId])
  @@index([organizationId])
}

model StepTemplate {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  trade          Trade
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          StepTemplateItem[]

  @@index([organizationId])
}

model StepTemplateItem {
  id              String       @id @default(cuid())
  templateId      String
  title           String
  order           Int
  weight          Int          @default(1)
  visibleToClient Boolean      @default(true)
  template        StepTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model SiteStep {
  id              String       @id @default(cuid())
  organizationId  String
  siteId          String
  title           String
  order           Int
  status          StepStatus   @default(TODO)
  plannedStart    DateTime?    @db.Date
  plannedEnd      DateTime?    @db.Date
  startedAt       DateTime?
  completedAt     DateTime?
  weight          Int          @default(1)
  visibleToClient Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignments     Assignment[]
  tasks           Task[]
  media           Media[]
  inboxProposals  InboxItem[]  @relation("InboxProposedStep")

  @@index([organizationId])
  @@index([siteId, order])
  @@index([status])
}

// ───────────────────────────── Planning ─────────────────────────────

model Assignment {
  id             String       @id @default(cuid())
  organizationId String
  siteId         String
  stepId         String?
  userId         String
  date           DateTime     @db.Date
  slot           Slot         @default(FULL_DAY)
  /// Start time "HH:MM" (optional).
  startTime      String?
  instructions   String?
  arrivedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  step           SiteStep?    @relation(fields: [stepId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([siteId])
  @@index([userId, date])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  siteId         String
  stepId         String?
  assigneeId     String?
  date           DateTime?    @db.Date
  title          String
  status         TaskStatus   @default(TODO)
  notes          String?
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  step           SiteStep?    @relation(fields: [stepId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([siteId])
  @@index([assigneeId, date])
  @@index([status])
}

// ───────────────────────────── Media, inbox, documents ─────────────────────────────

model Media {
  id                  String            @id @default(cuid())
  organizationId      String
  siteId              String?
  stepId              String?
  authorId            String?
  kind                MediaKind
  source              MediaSource       @default(APP)
  /// Original file, never modified.
  storageKey          String
  mimeType            String
  sizeBytes           Int
  originalName        String?
  thumbnailKey        String?
  /// Derived file (crop / blur). The original is kept intact.
  editedKey           String?
  /// Display version: auto-rotated, resized, metadata (EXIF / GPS) stripped. Served to clients.
  displayKey          String?
  width               Int?
  height              Int?
  durationSec         Float?
  /// Capture time declared by the device (EXIF or client clock).
  capturedAt          DateTime?
  /// Reliable server-side reception time.
  receivedAt          DateTime          @default(now())
  latitude            Float?
  longitude           Float?
  validationStatus    ValidationStatus  @default(PENDING)
  validatedById       String?
  validatedAt         DateTime?
  caption             String?
  transcription       String?
  transcriptionStatus ProcessingStatus?
  processingStatus    ProcessingStatus  @default(PENDING)
  /// Idempotency key generated by the offline queue.
  clientUploadId      String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  step                SiteStep?         @relation(fields: [stepId], references: [id], onDelete: SetNull)
  author              User?             @relation("MediaAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  inboxItems          InboxItem[]
  notes               Note[]

  @@index([organizationId])
  @@index([siteId, receivedAt])
  @@index([organizationId, validationStatus])
  @@index([authorId])
}

model InboxItem {
  id                   String        @id @default(cuid())
  organizationId       String
  kind                 InboxKind
  status               InboxStatus   @default(OPEN)
  mediaId              String?
  documentId           String?
  messageText          String?
  fromPhone            String?
  fromEmail            String?
  authorId             String?
  proposedSiteId       String?
  proposedStepId       String?
  proposedClientId     String?
  proposedDocumentType DocumentType?
  confidence           Float?
  reason               String?
  resolvedById         String?
  resolvedAt           DateTime?
  createdAt            DateTime      @default(now())
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media                Media?        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  document             Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  proposedSite         Site?         @relation("InboxProposedSite", fields: [proposedSiteId], references: [id], onDelete: SetNull)
  proposedStep         SiteStep?     @relation("InboxProposedStep", fields: [proposedStepId], references: [id], onDelete: SetNull)
  proposedClient       Client?       @relation("InboxProposedClient", fields: [proposedClientId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model Document {
  id                       String                   @id @default(cuid())
  organizationId           String
  siteId                   String?
  clientId                 String?
  type                     DocumentType             @default(OTHER)
  name                     String
  /// Original file, immutable.
  storageKey               String
  mimeType                 String
  sizeBytes                Int
  originalName             String
  sha256                   String
  documentDate             DateTime?                @db.Date
  amountCents              Int?
  currency                 String                   @default("EUR")
  supplier                 String?
  ocrText                  String?
  tags                     String[]
  visibleToClient          Boolean                  @default(false)
  source                   DocumentSource           @default(UPLOAD)
  processingStatus         ProcessingStatus         @default(PENDING)
  classificationConfidence Float?
  uploadedById             String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  searchVector             Unsupported("tsvector")?
  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                     Site?                    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  client                   Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  uploadedBy               User?                    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  inboxItems               InboxItem[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([siteId])
  @@index([clientId])
  @@index([documentDate])
  @@index([searchVector], type: Gin)
}

// ───────────────────────────── Journal & client portal ─────────────────────────────

model DailySummary {
  id             String        @id @default(cuid())
  organizationId String
  siteId         String
  date           DateTime      @db.Date
  generatedText  String
  editedText     String?
  status         SummaryStatus @default(DRAFT)
  mediaIds       String[]
  approvedById   String?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([organizationId, status])
}

model ClientPortalLink {
  id              String       @id @default(cuid())
  organizationId  String
  siteId          String
  /// SHA-256 of the token (lookup). The token itself is never stored in clear.
  tokenHash       String       @unique
  /// Token encrypted with a key derived from APP_SECRET (AES-256-GCM), so managers can copy the link again.
  tokenCiphertext String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastAccessAt    DateTime?
  accessCount     Int          @default(0)
  createdById     String?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([siteId])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  siteId         String
  authorId       String?
  kind           NoteKind     @default(NOTE)
  text           String
  /// Internal notes are never shown to the client. Problems are always internal.
  internal       Boolean      @default(true)
  mediaId        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  media          Media?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([organizationId])
}

model SiteEvent {
  id             String       @id @default(cuid())
  organizationId String
  siteId         String
  actorId        String?
  type           String
  payload        Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([organizationId, createdAt])
}

// ───────────────────────────── Messaging & notifications ─────────────────────────────

model WhatsAppContact {
  id             String       @id @default(cuid())
  organizationId String
  /// E.164 phone number, globally unique (it routes messages from the shared business number).
  phoneE164      String       @unique
  userId         String?
  clientId       String?
  label          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MessageLog {
  id             String           @id @default(cuid())
  organizationId String?
  channel        MessageChannel
  direction      MessageDirection
  provider       String
  externalId     String?
  fromAddress    String?
  toAddress      String?
  subject        String?
  body           String?
  payload        Json?
  status         String?
  createdAt      DateTime         @default(now())
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([channel, createdAt])
  @@index([toAddress])
  @@index([fromAddress])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  /// E-mail / Web Push delivery done (or not needed).
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([deliveredAt])
  @@index([organizationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  plan                   Plan
  status                 SubscriptionStatus
  provider               String
  externalCustomerId     String?
  externalSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Infrastructure ─────────────────────────────

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}
