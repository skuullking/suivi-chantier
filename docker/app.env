# Configuration of the Docker stack (local demo defaults). DO NOT put real secrets here:
# create a `.env.production` file at the root of the project to override any value (it is git-ignored).
# The development `.env` file is NOT used by the containers.

NODE_ENV=production
APP_URL=http://localhost
APP_SECRET=demo-only-secret-change-me-before-production-0000000000
LOG_LEVEL=info
ENABLE_DEV_TOOLS=true
SEED_DEMO=true
JOBS_MODE=queue
WORKER_POLL_INTERVAL_SECONDS=2
SITE_ADDRESS=:80

# PostgreSQL (container "postgres")
POSTGRES_USER=chantierlink
POSTGRES_PASSWORD=chantierlink
POSTGRES_DB=chantierlink
DATABASE_URL=postgresql://chantierlink:chantierlink@postgres:5432/chantierlink

# Files: MinIO (S3) in the stack
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-3
S3_BUCKET=chantierlink
S3_ACCESS_KEY_ID=chantierlink
S3_SECRET_ACCESS_KEY=chantierlink-minio-secret
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=chantierlink
MINIO_ROOT_PASSWORD=chantierlink-minio-secret
MAX_UPLOAD_MB=25

# E-mails: Mailpit (http://localhost:8025)
MAIL_DRIVER=smtp
MAIL_FROM=ChantierLink <no-reply@chantierlink.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
INBOUND_MAIL_DOMAIN=docs.chantierlink.local
INBOUND_MAIL_SECRET=dev-inbound-secret

# External services: simulated (see docs/BRANCHER_LES_SERVICES.md)
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
WHATSAPP_BUSINESS_NUMBER=+33600000000
TRANSCRIPTION_PROVIDER=mock
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-opus-5-5
OCR_PROVIDER=mock
BILLING_ENABLED=false
BILLING_PROVIDER=mock
VAPID_SUBJECT=mailto:contact@chantierlink.local
